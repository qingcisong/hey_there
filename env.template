# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Never commit real values. Never paste keys into a chat.

# --- Required ------------------------------------------------------
# OpenAI (Realtime API for gpt-realtime)
OPENAI_API_KEY=sk-proj-REPLACE-ME

# Groq (whisper transcription + llama valence)
GROQ_API_KEY=gsk_REPLACE-ME

# Access code gate. Anyone using the app enters this once, then it's
# remembered in their browser's localStorage. Rotate to invalidate
# all existing sessions. Any string works — 6 digits is a good default.
HEYTHERE_ACCESS_CODE=CHANGE-ME

# --- Optional ------------------------------------------------------
# REALTIME_MODEL=gpt-realtime
# WHISPER_MODEL=whisper-large-v3-turbo
# VALENCE_MODEL=openai/gpt-oss-20b
# PORT=3000
